# ========================================================
# GhubVNanoleaf - Comprehensive .gitignore
# ========================================================

# --- Environment & Sensitive Credentials ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Local Configuration ---
config/config.json
!config/config.example.json
!config/config.json.example

# --- Python Virtual Environments & Packages ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Byte-compiled / optimized files ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs & Temporary Files ---
logs/
*.log
*.tmp
*.bak
*.swp
*.swo

# --- Testing & Type Checkers ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- IDE & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
