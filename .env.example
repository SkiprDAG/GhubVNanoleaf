# ========================================================
# GhubVNanoleaf - Environment Configuration Template
# Скопируйте этот файл в .env и укажите ваши параметры
# ========================================================

# --- 1. Nanoleaf Controller ---
NANOLEAF_IP=192.168.1.100
NANOLEAF_TOKEN=your_auth_token_here
NANOLEAF_PORT=16021
NANOLEAF_TIMEOUT=5.0

# --- 2. Logitech G HUB (Локальный на ПК) ---
GHUB_WS_URL=ws://127.0.0.1:9010
GHUB_TIMEOUT=5.0

# --- 3. Master Server (HTTP / WebSocket) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
LOG_LEVEL=info
CONFIG_PATH=config/config.json

# --- 4. mDNS / Zeroconf Local Domain ---
# Анонсирует домен http://nanoleaf.local:8000 в локальной Wi-Fi сети
MDNS_ENABLED=true
MDNS_HOSTNAME=nanoleaf

# --- 5. Hybrid Desktop Agent Configuration ---
# Адрес Master-сервера для подключения агента с ПК
MASTER_SERVER_URL=ws://127.0.0.1:8000/api/agent/ws

